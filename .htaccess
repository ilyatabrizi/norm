# NORM Unity — Apache/cPanel.
#
# Deliberately contains no HTTPS or www redirect. cPanel has its own switches for
# both (Domains → Force HTTPS Redirect), they cannot produce a loop behind the
# host's proxy, and a hand-rolled RewriteRule here can. Use the panel.

# ---------------------------------------------------------------- MIME types
# Apache still ships without these two, and both fail silently: an unknown
# .webmanifest type makes the install prompt never appear, and a woff2 served as
# octet-stream is refused by the font loader.
AddType application/manifest+json .webmanifest
AddType font/woff2                .woff2
AddType image/webp                .webp
AddType image/svg+xml             .svg
AddType text/javascript           .js

# ------------------------------------------------------------------- caching
# The app's filenames never change, so the shell and the code must revalidate on
# every load or an update cannot reach anyone. The service worker already asks
# the network for these; this stops the browser's own cache from disagreeing.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:html|css|js|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(?:woff2|jpe?g|png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # sw.js is the one file that must never be held, at any layer.
  <Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/manifest+json image/svg+xml
</IfModule>

ErrorDocument 404 /404.html

# Nothing here is generated, so directory listings only leak structure.
Options -Indexes
